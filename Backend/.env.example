# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/minihardware
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/minihardware

# JWT Security
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated or JSON list of allowed origins)
CORS_ORIGINS=*

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Seed Credentials (for seed script)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@minihardware.com
SEED_ADMIN_PASSWORD=Admin123!
